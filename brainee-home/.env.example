# URL de ton Home Assistant (local)
HA_URL=http://homeassistant.local:8123

# Token HA : Profil → Sécurité → Tokens d'accès longue durée
HA_TOKEN=ton_token_ici

# Clé Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Port du serveur (défaut 3002)
PORT=3002

# Modèle Claude (haiku = économique, sonnet = plus intelligent)
MODEL=claude-haiku-4-5-20251001
